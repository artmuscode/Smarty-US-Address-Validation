<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/smarty-address-validation/autocomplete" method="POST">
        <service class="Custom\SmartyAddressValidation\Api\AddressAutocompleteInterface" method="suggest"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/smarty-address-validation/validate" method="POST">
        <service class="Custom\SmartyAddressValidation\Api\AddressValidatorInterface" method="validate"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
